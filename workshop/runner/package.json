{
  "name": "intro-harness-engineering-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:h4": "tsx src/validate-policy.ts",
    "check:policy": "npm run check:h4",
    "workshop:start": "tsx src/workshop-cli.ts start",
    "workshop:doctor": "tsx src/workshop-cli.ts doctor",
    "workshop:status": "tsx src/workshop-cli.ts status",
    "workshop:ladder": "tsx src/workshop-cli.ts ladder",
    "workshop:record-decision": "tsx src/workshop-cli.ts record-decision",
    "workshop:h4": "tsx src/workshop-cli.ts h4",
    "workshop:compare": "tsx src/workshop-cli.ts compare",
    "workshop:finish": "tsx src/workshop-cli.ts finish",
    "prime:sync": "uvx --from uv==0.11.1 uv sync --project prime --locked",
    "prime:h0": "tsx src/prime-run.ts h0",
    "prime:h1": "tsx src/prime-run.ts h1",
    "prime:h2": "tsx src/prime-run.ts h2",
    "prime:h3": "tsx src/prime-run.ts h3",
    "prime:h4": "tsx src/prime-run.ts h4",
    "prime:inspect": "tsx src/prime-inspect.ts",
    "prime:compare": "tsx src/prime-compare.ts",
    "test:prime-controls": "tsx src/fixed-controls-fixture-test.ts",
    "test:prime-inspect": "tsx src/prime-inspect-fixture-test.ts",
    "test:workshop-state": "tsx src/workshop-state-fixture-test.ts",
    "test:workshop-cli": "tsx src/workshop-cli-fixture-test.ts",
    "test:ladder-policy": "tsx src/ladder-policy-fixture-test.ts",
    "reset:h4": "tsx src/reset-policy.ts",
    "reset:policy": "npm run reset:h4",
    "run": "tsx src/cli.ts",
    "smoke": "tsx src/cli.ts --mode fixture --fixture fixtures/hello-task --task hello-task --candidate baseline --run-root .smoke-runs",
    "smoke:retry": "tsx src/integration-smoke-retry.ts",
    "test:trace": "tsx src/trace-fixture-test.ts",
    "test:isolation": "tsx src/isolation-fixture-test.ts",
    "test:compare": "tsx src/compare-fixture-test.ts",
    "compare": "tsx src/compare.ts",
    "reset:harness": "tsx src/reset-harness.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "tsx": "4.23.12",
    "typescript": "5.7.2"
  }
}
